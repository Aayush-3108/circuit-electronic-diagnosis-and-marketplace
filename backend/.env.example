# Backend configuration — copy of .env.example with safe defaults.
# The app works without any API keys:
#   - YOLO model runs locally (no key needed)
#   - Chatbot shows "demo mode" message
#   - Upgrade advisor shows "demo mode" message
#   - Repair shops fall back to OpenStreetMap (no key needed)
#   - Firebase auth is optional (history won't save without it)

# ── CV Model ───────────────────────────────────────────────────────────────
YOLO_LOCAL_WEIGHTS_PATH=models/yolo_damage_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

# Roboflow (optional hosted fallback — not needed since local model exists)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ENDPOINT=

# ── Chatbot (Groq) — add free key from https://console.groq.com/keys ───────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Upgrade Advisor (Gemini) — add free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── Firebase — optional, needed for scan history saving ───────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Fraud Detection & Isolation Forest ────────────────────────────────────
FRAUD_MODEL_PATH=models/isolation_forest_fraud.joblib
FRAUD_FEATURE_SCHEMA_PATH=models/fraud_feature_schema.joblib
FRAUD_CONTAMINATION=0.05
FRAUD_MODEL_VERSION=isolation_forest_v1.0
# Comma-separated list of emails with administrative authorization:
ADMIN_EMAILS=admin@recircuit.com,admin@example.com

# ── Authentication Security & Brute-Force Rate Limiting ───────────────────
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_COOLDOWN_MINUTES=15
