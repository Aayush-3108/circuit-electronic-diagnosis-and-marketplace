# Copy this file to .env and fill in your free-tier keys.
# None of these services cost money on the free tiers used by this project.

# ── CV Model (YOLOv8) ──────────────────────────────────────────────────────
# Path to trained local weights (output of ml/scripts/train_yolo.py --copy-to-backend).
# If this file exists, it's used instead of the Roboflow hosted endpoint.
# Path is relative to backend/ (where uvicorn is run from).
YOLO_LOCAL_WEIGHTS_PATH=models/yolo_damage_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

# Roboflow hosted inference (optional fallback — only used if no local .pt file found)
# Get a free key at https://roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=
# After training/hosting your YOLOv8 model on Roboflow, paste its hosted inference URL here.
# Format: https://detect.roboflow.com/<project-slug>/<version>
ROBOFLOW_MODEL_ENDPOINT=

# ── Chatbot (Groq) ─────────────────────────────────────────────────────────
# Free tier — get a key at https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
GROQ_API_KEY=your_groq_api_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Upgrade Advisor (Google Gemini) ────────────────────────────────────────
# Free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=you_gemini_api_here
GEMINI_MODEL=gemini-1.5-flash

# ── Firebase (Auth token verification) ─────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Download the JSON file and save it anywhere, then point this to it.
FIREBASE_CREDENTIALS_PATH=your_firebase_service

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# The Vercel URL below is already baked into config.py defaults.
# Only set this env var on Render if you add extra/custom domains.
# ALLOWED_ORIGINS=["http://localhost:5173","https://circuit-electronic-diagnosis-and-ma.vercel.app"]
